+// QuestShip: the flat-screen panel's laser pointer. Same ray-vs-quad test as the settings menu,
+// against the panel's pose and size (local_space, so the raw pre-turn aim poses). The dominant hand
+// (gVrLeftHanded) is tried first.
+static float vr_flat_width_m() {
+    return fmaxf(CVarGetFloat("gVrScreenSize", 2.4f), 0.5f);
+}
+
+static void vr_flat_pointer_update() {
+    xr.flat_ptr_hit = false;
+    if (!xr.input_initialized || !xr.flat_screen || xr.menu_open) {
+        return;
+    }
+    const glm::vec3 c(xr.flat_pose.position.x, xr.flat_pose.position.y, xr.flat_pose.position.z);
+    const glm::quat qm(xr.flat_pose.orientation.w, xr.flat_pose.orientation.x, xr.flat_pose.orientation.y,
+                       xr.flat_pose.orientation.z);
+    const glm::vec3 n = qm * glm::vec3(0.0f, 0.0f, 1.0f);
+    const float w = vr_flat_width_m();
+    const float h = w * 0.75f;
+    const int dominant = CVarGetInteger("gVrLeftHanded", 0) ? 0 : 1;
+    const int hands[2] = { dominant, 1 - dominant };
+    for (int i = 0; i < 2; i++) {
+        const int hd = hands[i];
+        if (!xr.hand_active[hd]) {
+            continue;
+        }
+        const XrPosef& ap = xr.aim_pose_raw[hd];
+        const glm::vec3 o(ap.position.x, ap.position.y, ap.position.z);
+        const glm::vec3 d = glm::quat(ap.orientation.w, ap.orientation.x, ap.orientation.y, ap.orientation.z) *
+                            glm::vec3(0.0f, 0.0f, -1.0f);
+        const float denom = glm::dot(d, n);
+        if (denom > -1e-4f) {
+            continue; // parallel or pointing away from the panel's front
+        }
+        const float t = glm::dot(c - o, n) / denom;
+        if (t < 0.0f) {
+            continue;
+        }
+        const glm::vec3 local = glm::conjugate(qm) * (o + d * t - c);
+        const float u = local.x / w + 0.5f;
+        const float v = 0.5f - local.y / h;
+        if (u < 0.0f || u > 1.0f || v < 0.0f || v > 1.0f) {
+            continue;
+        }
+        xr.flat_ptr_hit = true;
+        xr.flat_ptr_hand = hd;
+        xr.flat_ptr_u = u;
+        xr.flat_ptr_v = v;
+        break;
+    }
+}
+
+bool vr_flat_pointer(float* u, float* v, int* hand) {
+    if (!xr.initialized || !xr.enabled || !xr.flat_ptr_hit) {
+        return false;
+    }
+    *u = xr.flat_ptr_u;
+    *v = xr.flat_ptr_v;
+    *hand = xr.flat_ptr_hand;
+    return true;
+}
+
 bool vr_menu_is_open() {
     return xr.initialized && xr.enabled && xr.menu_open;
 }
